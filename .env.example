# ============================================================
# Morpho Blue Monitor & Webapp — Configuration Template
# Copy file này sang .env:  cp .env.example .env
# Sau đó chỉnh sửa .env theo nhu cầu của bạn
# ============================================================

# ---- Morpho Blue Market ----
# Market ID (32-byte hex) cần theo dõi
MARKET_ID=0x24852d8d7464402ddcd717415e009d42bf7427d6a8893487f83c75ee0f4a0ea6
# Địa chỉ ví lender cần theo dõi vị thế
LENDER_ADDRESS=
# Địa chỉ Morpho Blue contract trên Ethereum mainnet
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb

# ---- RPC Endpoints (phân cách bằng dấu phẩy) ----
# RPC endpoints đã được kiểm chứng (phân cách bằng dấu phẩy)
RPC_URLS=https://lb.drpc.live/ethereum/AlqTJ3Pbb0gGqQof0HI4hLunOH9fcQYR8aFWVjewFaCJ,https://lb.drpc.live/ethereum/AunJZVj7QEqckownxj_qxRnQ2DzbcQYR8aFXVjewFaCJ,https://ethereum-rpc.publicnode.com,https://eth-mainnet.g.alchemy.com/v2/usw2oMtZYpOnwPTrHcEGL,https://eth-mainnet.g.alchemy.com/v2/WeGRNBp6KnWDuMSuyE7r9,https://rpc.ankr.com/eth/0bda9fd26145d611152a6eec8b728bf7747688a87037d5da4a0bb1feb42977f8,https://rpc.ankr.com/eth/75c3d8f64c68d868b9e194da044b3f61849506bef26508a419985bfc5c46c338,https://ethereum-mainnet.core.chainstack.com/ea59b26bd098e71a4ad2cf8292ae4f3a,https://ethereum-mainnet.core.chainstack.com/9a4bbcc8b9369e3c7247274b75736e64,https://eth.api.onfinality.io/rpc?apikey=135ff6c2-cfc7-41f7-acf6-646032a330f2,https://eth.api.onfinality.io/rpc?apikey=1049978f-377b-40d0-88c4-efd422e61852

# ---- WebSocket RPC (real-time event trigger, tùy chọn) ----
# WSS endpoints để nhận events real-time từ Morpho Blue (Supply, Withdraw, Borrow, Repay, Liquidate).
# Dùng làm trigger đánh thức checkAndNotify() ngay lập tức thay vì chờ tới chu kỳ poll tiếp theo.
# Để trống để chạy HTTP-only mode (chỉ dùng polling). Phân cách bằng dấu phẩy.
# VD: wss://ethereum-rpc.publicnode.com,wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
WSS_URLS=wss://ethereum-rpc.publicnode.com
# Debounce window cho WebSocket events (ms) — gộp nhiều events trong cùng block
# thành 1 lần check duy nhất để tránh gọi fetchMarket() quá nhiều. Mặc định 3000.
# WSS_DEBOUNCE_MS=3000

# ---- Monitor Settings ----
# Khoảng thời gian giữa các lần kiểm tra (milliseconds), mặc định 30 giây
MONITOR_INTERVAL_MS=30000
# Ngưỡng thanh khoản tối thiểu để gửi thông báo (tính bằng USDC)
MIN_LIQUIDITY_THRESHOLD_USDC=100
# Khoảng thời gian tối thiểu giữa 2 thông báo liên tiếp (phút)
NOTIFICATION_COOLDOWN_MINUTES=30
# Số thông báo tối đa trong 1 ngày
MAX_NOTIFICATIONS_PER_DAY=10
# Hệ số ngưỡng giảm thanh khoản đột ngột
# drainThreshold = supplyAssets × SUDDEN_DRAIN_MULTIPLIER
# Mặc định 2: cảnh báo khi liquidity ≤ 2× vị thế lender
SUDDEN_DRAIN_MULTIPLIER=2

# ---- ntfy.sh ----
# Server ntfy (có thể dùng server tự host hoặc ntfy.sh)
NTFY_SERVER=https://ntfy.sh
# Topic ntfy — để trống để tự sinh ngẫu nhiên; hoặc đặt tên mong muốn
NTFY_TOPIC=

# ---- VoIP Call Notifications (cypherpunk REST API) ----
# Secret key để xác thực với API VoIP. Để trống để tắt tính năng gọi VoIP.
VOIP_SECRET_KEY=
# Base URL của VoIP API
# VOIP_API_URL=http://cypherpunk.chainno.de:8000
# Đích SIP để nhận cuộc gọi (mặc định: sip:vanphandinh@sip.linphone.org)
# VOIP_TARGET=sip:vanphandinh@sip.linphone.org
# Số lần thử lại tối đa khi cuộc gọi thất bại
# VOIP_MAX_RETRIES=3
# Thời gian chờ giữa các lần thử lại (milliseconds)
# VOIP_RETRY_DELAY_MS=5000

# ---- Webapp ----
# ---- SSL/TLS (để trống = HTTP) ----
# Đường dẫn tới chứng chỉ và private key (Let's Encrypt fullchain.pem + privkey.pem).
# Khi cả hai được thiết lập, server sẽ chạy HTTPS thay vì HTTP.
# Với Docker: /etc/letsencrypt được mount vào /certs/ (xem docker-compose.yml).
# Thay your-domain.com bằng tên miền thật của bạn:
#   SSL_CERT_PATH=/certs/live/your-domain.com/fullchain.pem
#   SSL_KEY_PATH=/certs/live/your-domain.com/privkey.pem
SSL_CERT_PATH=
SSL_KEY_PATH=

# ---- Server Address (canonical — tất cả service khác derive từ đây) ----
# Proxy RPC URL tự động = WEBAPP_URL host + port 8545
# Trên VPS với HTTPS: https://<your-domain.com>
# Local dev: http://localhost:3000
WEBAPP_URL=http://localhost:3000
# Port webapp server
WEBAPP_PORT=3000
# Mật khẩu bảo vệ webapp + API endpoints + proxy (HTTP Basic Auth). Để trống để tắt tất cả bảo vệ.
WEBAPP_PASSWORD=

# ---- Pre-Signed Withdrawals ----
# File path nơi monitor đọc signed transactions
PRESIGNED_FILE=./data/presigned.json
# Port proxy RPC (mặc định 8545)
PROXY_PORT=8545
# Bind address của proxy. Mặc định 127.0.0.1 (local only).
# VPS / MetaMask mobile: PROXY_HOST=0.0.0.0 và mở firewall 8545.
# eth_sendRawTransaction chỉ chấp nhận tx từ LENDER_ADDRESS (Morpho withdraw).
# /bundle và /captured yêu cầu Bearer lender hoặc Basic WEBAPP_PASSWORD.
# PROXY_HOST=0.0.0.0
