[TEMPLATE]
# ============================================================
# Morpho Blue Monitor & Webapp — Configuration Template
# Copy file này sang .env:  cp .env.example .env
# Sau đó chỉnh sửa .env theo nhu cầu của bạn
# ============================================================

# ---- Morpho Blue Markets ----
# Required JSON allow-list. Copy config/markets.example.json to
# config/markets.json, then add every market to follow (1–9 markets; 10 fails at startup).
# Nếu thiếu file này, mọi service dừng ngay với hướng dẫn copy/mount.
MARKETS_FILE=./config/markets.json
# LƯU Ý (v1 → v2): các key cũ MARKET_ID, MIN_LIQUIDITY_THRESHOLD_USDC,
# SUDDEN_DRAIN_MULTIPLIER KHÔNG còn được đọc. Ngưỡng nằm trong markets.json.
# Địa chỉ ví lender cần theo dõi vị thế
LENDER_ADDRESS=
# Địa chỉ Morpho Blue contract trên Ethereum mainnet
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb

# ---- RPC Endpoints (phân cách bằng dấu phẩy) ----
# LƯU Ý: danh sách này được inject vào browser qua window.MORPHO_CONFIG.rpcUrls
# khi webapp-server khởi động. KHÔNG hardcode URL/API key trong webapp.html
# (file đó được phục vụ công khai — key nằm trong HTML sẽ bị lộ).
# ⚠️ KHÔNG commit API key thật vào file này (audit 2026-09-24 P1): key từng nằm
# trong file này đã lộ trong lịch sử git — CẦN ROTATE trên console của từng nhà
# cung cấp (drpc/alchemy/ankr/chainstack/onfinality) và chỉ đặt key mới trong
# .env (gitignored). Ví dụ bên dưới: endpoint công khai không key + placeholder.
RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com,https://eth.drpc.org,https://YOUR_PROVIDER.example/YOUR_RPC_KEY

# ---- WebSocket RPC (real-time event trigger, tùy chọn) ----
# WSS endpoints để nhận events real-time từ Morpho Blue (Supply, Withdraw, Borrow, Repay, Liquidate).
# Dùng làm trigger đánh thức checkAndNotify() ngay lập tức thay vì chờ tới chu kỳ poll tiếp theo.
# Để trống để chạy HTTP-only mode (chỉ dùng polling). Phân cách bằng dấu phẩy.
# VD: wss://ethereum-rpc.publicnode.com,wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
WSS_URLS=wss://ethereum-rpc.publicnode.com
# Debounce window cho WebSocket events (ms) — gộp nhiều events trong cùng block
# thành 1 lần check duy nhất để tránh gọi fetchMarket() quá nhiều. Mặc định 3000.
# WSS_DEBOUNCE_MS=3000

# ---- Monitor Settings ----
# Khoảng thời gian giữa các lần kiểm tra (milliseconds), mặc định 30 giây
MONITOR_INTERVAL_MS=30000
# Mỗi market có minLiquidity theo decimals của loan token trong markets.json.
# Khoảng thời gian tối thiểu giữa 2 thông báo liên tiếp (phút)
NOTIFICATION_COOLDOWN_MINUTES=30
# Số thông báo tối đa trong 1 ngày
MAX_NOTIFICATIONS_PER_DAY=10
# ---- ntfy.sh ----
# Server ntfy (có thể dùng server tự host hoặc ntfy.sh)
NTFY_SERVER=https://ntfy.sh
# Topic ntfy — để trống để tự sinh ngẫu nhiên; hoặc đặt tên mong muốn
NTFY_TOPIC=

# ---- VoIP Call Notifications (cypherpunk REST API) ----
# Secret key để xác thực với API VoIP. Để trống để tắt tính năng gọi VoIP.
VOIP_SECRET_KEY=
# Base URL của VoIP API
# VOIP_API_URL=http://cypherpunk.chainno.de:8000
# Đích SIP để nhận cuộc gọi (mặc định: sip:vanphandinh@sip.linphone.org)
# VOIP_TARGET=sip:vanphandinh@sip.linphone.org
# Số lần thử lại tối đa khi cuộc gọi thất bại
# VOIP_MAX_RETRIES=3
# Thời gian chờ giữa các lần thử lại (milliseconds)
# VOIP_RETRY_DELAY_MS=5000

# ---- Webapp ----
# ---- SSL/TLS (để trống = HTTP) ----
# Đường dẫn tới chứng chỉ và private key (Let's Encrypt fullchain.pem + privkey.pem).
# Khi cả hai được thiết lập, server sẽ chạy HTTPS thay vì HTTP.
# Với Docker: /etc/letsencrypt được mount vào /certs/ (xem docker-compose.yml).
# Thay your-domain.com bằng tên miền thật của bạn:
#   SSL_CERT_PATH=/certs/live/your-domain.com/fullchain.pem
#   SSL_KEY_PATH=/certs/live/your-domain.com/privkey.pem
SSL_CERT_PATH=
SSL_KEY_PATH=

# ---- Server Address (canonical — tất cả service khác derive từ đây) ----
# Proxy RPC URL tự động = WEBAPP_URL host + port 8545
# Trên VPS với HTTPS: https://<your-domain.com>
# Local dev: http://localhost:3000
WEBAPP_URL=http://localhost:3000
# PROXY_RPC_URL (tùy chọn) — để trống thì tự derive = host của WEBAPP_URL + PROXY_PORT
# (trên VPS/HTTPS: https://your-domain.com:8545). Chỉ set khi proxy ở port/host khác.
# PROXY_RPC_URL=https://your-domain.com:8545
# Port webapp server
WEBAPP_PORT=3000
# Mật khẩu bảo vệ webapp + API endpoints + proxy (HTTP Basic Auth).
# Bắt buộc khi deploy: webapp fail-fast nếu trống (không mật khẩu thì MỌI request
# đều được coi là đã xác thực, kể cả DELETE bundle đã ký).
# Dev local: set WEBAPP_ALLOW_INSECURE=1 để chạy không cần mật khẩu — KHÔNG dùng
# trên VPS/public.
WEBAPP_PASSWORD=
# WEBAPP_ALLOW_INSECURE=1

# ---- Pre-Signed Withdrawals ----
# Registry v3 nơi monitor đọc signed transactions (key composite marketId@nonce;
# đọc được cả registry v2 cũ)
PRESIGNED_FILE=./data/presigned.json
# Port proxy RPC (mặc định 8545)
PROXY_PORT=8545
# Bind address của proxy. Mặc định 127.0.0.1 (local only).
# VPS / MetaMask mobile: PROXY_HOST=0.0.0.0 và mở firewall 8545.
# eth_sendRawTransaction chỉ chấp nhận tx từ LENDER_ADDRESS (Morpho withdraw).
# /bundle và /captured yêu cầu Bearer lender hoặc Basic WEBAPP_PASSWORD.
# LƯU Ý (audit D3): WEBAPP_PASSWORD KHÔNG đóng nhánh JSON-RPC (eth_call/
# eth_getLogs/eth_feeHistory...). Ví không gửi được header Authorization nên relay
# buộc phải công khai => bind 0.0.0.0 nghĩa là ai vào được port cũng forward được
# sang RPC_URLS của bạn. Giới hạn bằng firewall / IP allow-list, đừng trông vào mật khẩu.
# PROXY_HOST=0.0.0.0

# ---- Giới hạn nhánh JSON-RPC của proxy (audit O2) — MẶC ĐỊNH TẮT ----
# WEBAPP_PASSWORD không đóng được relay JSON-RPC (ví không gửi header Authorization),
# nên khi bind public chỉ còn hai cách giới hạn dưới đây. Bỏ trống = hành vi như trước.
# 1) Số request mỗi IP trong một cửa sổ 60s: vượt ngưỡng trả lỗi JSON-RPC -32005
#    (HTTP 200, KHÔNG phải 429 — 429 sẽ khiến ví thử lại như lỗi mạng tạm thời).
#    Ví bắn eth_call/eth_estimateGas theo cụm nên đặt rộng tay, ví dụ 600.
# PROXY_RPC_RATE_LIMIT=600
# 2) Chỉ cho tập method mà một ví cần (eth_chainId, eth_call, eth_estimateGas,
#    eth_getTransactionCount, eth_sendRawTransaction, eth_getLogs, eth_feeHistory...).
#    Đây là công tắc chính sách; hàng rào chống lạm dụng thật là (1).
# PROXY_ALLOW_PUBLIC_RPC=1
