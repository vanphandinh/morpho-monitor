# ============================================================
# Morpho Blue Monitor & Webapp — Configuration Template
# Copy file này sang .env:  cp .env.example .env
# Sau đó chỉnh sửa .env theo nhu cầu của bạn
# ============================================================

# ---- Morpho Blue Market ----
# Market ID (32-byte hex) cần theo dõi
MARKET_ID=0x24852d8d7464402ddcd717415e009d42bf7427d6a8893487f83c75ee0f4a0ea6
# Địa chỉ ví lender cần theo dõi vị thế
LENDER_ADDRESS=
# Địa chỉ Morpho Blue contract trên Ethereum mainnet
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb

# ---- RPC Endpoints (phân cách bằng dấu phẩy) ----
# Đã test thực tế 3 lần mỗi RPC với eth_getTransactionCount (2025-06-26)
# Xếp theo latency: blockrazor (171ms) > publicnode (353ms) > drpc (390ms) > pocket (546ms) > 0xrpc (591ms) > flashbots (615ms) > mevblocker (631ms) > nodeflare (905ms)
RPC_URLS=https://eth.blockrazor.xyz,https://ethereum-rpc.publicnode.com,https://eth.drpc.org,https://eth.api.pocket.network,https://0xrpc.io/eth,https://rpc.flashbots.net,https://rpc.mevblocker.io,https://rpc.nodeflare.app/eth/public

# ---- Monitor Settings ----
# Khoảng thời gian giữa các lần kiểm tra (milliseconds), mặc định 30 giây
MONITOR_INTERVAL_MS=30000
# Ngưỡng thanh khoản tối thiểu để gửi thông báo (tính bằng USDC)
MIN_LIQUIDITY_THRESHOLD_USDC=100
# Khoảng thời gian tối thiểu giữa 2 thông báo liên tiếp (phút)
NOTIFICATION_COOLDOWN_MINUTES=30
# Số thông báo tối đa trong 1 ngày
MAX_NOTIFICATIONS_PER_DAY=10

# ---- ntfy.sh ----
# Server ntfy (có thể dùng server tự host hoặc ntfy.sh)
NTFY_SERVER=https://ntfy.sh
# Topic ntfy — để trống để tự sinh ngẫu nhiên; hoặc đặt tên mong muốn
NTFY_TOPIC=

# ---- Webapp ----
# ---- Server Address (canonical — tất cả service khác derive từ đây) ----
# Proxy RPC URL tự động = WEBAPP_URL host + port 8545
# Trên VPS: http://<vps-ip>:3000
# Local dev: http://localhost:3000
WEBAPP_URL=http://localhost:3000
# Port webapp server
WEBAPP_PORT=3000
# Mật khẩu bảo vệ webapp + API endpoints + proxy (HTTP Basic Auth). Để trống để tắt tất cả bảo vệ.
WEBAPP_PASSWORD=

# ---- Pre-Signed Withdrawals ----
# File path nơi monitor đọc signed transactions
PRESIGNED_FILE=./data/presigned.json
# Port proxy RPC (mặc định 8545)
PROXY_PORT=8545
