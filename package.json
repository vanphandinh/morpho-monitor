{
  "name": "morpho",
  "version": "1.0.0",
  "description": "Morpho Blue multi-market liquidity monitor, pre-signed withdrawal webapp and capture RPC proxy",
  "main": "index.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env index.mjs",
    "monitor": "node --env-file=.env monitor.mjs",
    "webapp": "node --env-file=.env webapp-server.mjs",
    "proxy": "node --env-file=.env proxy-rpc.mjs",
    "dev": "concurrently -n monitor,webapp,proxy -c blue,green,yellow \"npm run monitor\" \"npm run webapp\" \"npm run proxy\"",
    "verify": "node verify-presigned.mjs",
    "lint": "oxlint --deny no-undef --deny-warnings *.mjs __tests__ scripts",
    "check": "npm run lint && node scripts/check-syntax.mjs && vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "morpho",
    "ethereum",
    "monitor"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@morpho-org/blue-sdk": "^6.2.0",
    "@morpho-org/blue-sdk-viem": "^5.1.1",
    "@morpho-org/morpho-ts": "^2.6.0",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "oxlint": "^1.85.0",
    "vitest": "^4.1.9"
  }
}
